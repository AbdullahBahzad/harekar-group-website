# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/harekar_group?schema=public"

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"

# The intelligence map needs no key. It draws OpenStreetMap data on CARTO's
# dark basemap tiles, both free to use with the attribution the map already
# displays — see `IraqOpenMap`.

# Auth.js — signs and encrypts session cookies.
# Generate with: npx auth secret   (or: openssl rand -base64 32)
# Changing this invalidates every existing session.
AUTH_SECRET=""

# Required in production so Auth.js builds absolute callback URLs correctly.
# Not needed for local development.
# AUTH_URL="https://harekargroup.com"

# The site's own public origin.
# Required in production, where it is the only source of any absolute URL the
# application hands to somebody else — chiefly the payment gateway's return
# URL. It cannot be read off the request, because the Host header is set by
# whoever is calling and a forged one would send a paying customer somewhere
# else entirely. Locally it is unset and the request is trusted instead.
# APP_URL="https://harekargroup.com"

# Payment gateway for Pro subscriptions.
# "stub" is a development-only stand-in that grants access without taking
# money — it refuses to run when NODE_ENV is production. There is no default:
# an unset value stops the request in production rather than quietly selecting
# the stub, which would grant Pro without charging for it.
PAYMENT_PROVIDER="stub"

# Opens the admin console WITHOUT signing in, so its design can be reviewed on a
# machine with no database. Off unless set to exactly "1", and ignored entirely
# when NODE_ENV=production. Leave this unset unless you are working on the
# console's appearance.
# ADMIN_PREVIEW="1"

# Claude API key, for drafting Daily Security Report items in the admin
# console's Reports station from curated source articles.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# ---- outbound mail -------------------------------------------------------
# Internal alerts when a quote request or job application arrives, so they are
# not only seen by someone opening the console.
#
# "log" writes the message to the server log instead of sending it. Unlike the
# payment stub it does not refuse to run in production — a missed alert is
# recoverable (the submission is in the console either way), and throwing would
# break the contact form over a mail problem. It warns loudly instead.
MAIL_TRANSPORT="log"

# The address alerts are sent from. Must be one the sending domain is
# authorised to use, or the mail will be filtered as spam. Nothing is sent
# while this is empty.
MAIL_FROM="no-reply@harekargroup.com"

# The operations inbox that receives the alerts. Nothing is sent while this is
# empty — a guessed recipient is mail nobody reads, which looks like success.
MAIL_TO=""
